{
  "components": {
    "schemas": {
      "AllOfBonus": {
        "additionalProperties": false,
        "description": "``points`` are awarded when every listed mission succeeds.",
        "properties": {
          "kind": {
            "const": "all_of_bonus",
            "default": "all_of_bonus",
            "title": "Kind",
            "type": "string"
          },
          "missions": {
            "items": {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            },
            "maxItems": 32,
            "minItems": 2,
            "title": "Missions",
            "type": "array"
          },
          "points": {
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Points",
            "type": "number"
          }
        },
        "required": [
          "kind",
          "missions",
          "points"
        ],
        "title": "AllOfBonus",
        "type": "object"
      },
      "Arena": {
        "additionalProperties": false,
        "properties": {
          "grid_resolution": {
            "description": "Grid cell size in metres",
            "maximum": 0.25,
            "minimum": 0.002,
            "title": "Grid Resolution",
            "type": "number"
          },
          "height": {
            "exclusiveMinimum": 0.0,
            "maximum": 20.0,
            "title": "Height",
            "type": "number"
          },
          "home_zones": {
            "items": {
              "$ref": "#/components/schemas/Zone"
            },
            "maxItems": 4,
            "title": "Home Zones",
            "type": "array"
          },
          "obstacles": {
            "items": {
              "$ref": "#/components/schemas/Obstacle"
            },
            "maxItems": 200,
            "title": "Obstacles",
            "type": "array"
          },
          "start_pose": {
            "$ref": "#/components/schemas/Pose"
          },
          "width": {
            "exclusiveMinimum": 0.0,
            "maximum": 20.0,
            "title": "Width",
            "type": "number"
          }
        },
        "required": [
          "width",
          "height",
          "grid_resolution",
          "obstacles",
          "home_zones",
          "start_pose"
        ],
        "title": "Arena",
        "type": "object"
      },
      "CircleShape": {
        "additionalProperties": false,
        "properties": {
          "cx": {
            "maximum": 40.0,
            "minimum": -20.0,
            "title": "Cx",
            "type": "number"
          },
          "cy": {
            "maximum": 40.0,
            "minimum": -20.0,
            "title": "Cy",
            "type": "number"
          },
          "kind": {
            "const": "circle",
            "default": "circle",
            "title": "Kind",
            "type": "string"
          },
          "radius": {
            "exclusiveMinimum": 0.0,
            "maximum": 20.0,
            "title": "Radius",
            "type": "number"
          }
        },
        "required": [
          "kind",
          "cx",
          "cy",
          "radius"
        ],
        "title": "CircleShape",
        "type": "object"
      },
      "CompetitionFormat": {
        "additionalProperties": false,
        "description": "How a match is structured.\n\n``single_run`` (WRO RoboMission style): one continuous attempt, no touching the robot.\n``multi_run`` (FLL Challenge style): the robot returns to a home zone between runs, where the\nteam may change attachments; ``reset_time`` is the handling time spent in home per return.\n``must_end_in_home``: the plan must finish with the robot in a home zone.",
        "properties": {
          "kind": {
            "enum": [
              "single_run",
              "multi_run"
            ],
            "title": "Kind",
            "type": "string"
          },
          "must_end_in_home": {
            "default": false,
            "title": "Must End In Home",
            "type": "boolean"
          },
          "reset_time": {
            "default": 0.0,
            "maximum": 120.0,
            "minimum": 0.0,
            "title": "Reset Time",
            "type": "number"
          },
          "time_budget": {
            "description": "Match length in seconds",
            "exclusiveMinimum": 0.0,
            "maximum": 600.0,
            "title": "Time Budget",
            "type": "number"
          }
        },
        "required": [
          "kind",
          "time_budget",
          "reset_time",
          "must_end_in_home"
        ],
        "title": "CompetitionFormat",
        "type": "object"
      },
      "CountsSuccess": {
        "additionalProperties": false,
        "description": "Success measured in practice: ``successes`` out of ``attempts``.\n\nThe point estimate is the posterior mean under a uniform Beta(1, 1) prior,\n``(s + 1) / (n + 2)`` (Laplace's rule of succession). It never returns exactly 0 or 1, because\na finite number of practice runs cannot establish certainty.",
        "properties": {
          "attempts": {
            "maximum": 100000.0,
            "minimum": 1.0,
            "title": "Attempts",
            "type": "integer"
          },
          "kind": {
            "const": "counts",
            "default": "counts",
            "title": "Kind",
            "type": "string"
          },
          "successes": {
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Successes",
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "successes",
          "attempts"
        ],
        "title": "CountsSuccess",
        "type": "object"
      },
      "Empirical": {
        "additionalProperties": false,
        "description": "Resample from measured values (e.g. stopwatch times from practice).",
        "properties": {
          "kind": {
            "const": "empirical",
            "default": "empirical",
            "title": "Kind",
            "type": "string"
          },
          "samples": {
            "items": {
              "maximum": 600.0,
              "minimum": 0.0,
              "type": "number"
            },
            "maxItems": 10000,
            "minItems": 1,
            "title": "Samples",
            "type": "array"
          }
        },
        "required": [
          "kind",
          "samples"
        ],
        "title": "Empirical",
        "type": "object"
      },
      "ExampleSummary": {
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description"
        ],
        "title": "ExampleSummary",
        "type": "object"
      },
      "Excludes": {
        "additionalProperties": false,
        "description": "At most one of the two missions may be chosen.",
        "properties": {
          "a": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "A",
            "type": "string"
          },
          "b": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "B",
            "type": "string"
          },
          "kind": {
            "const": "excludes",
            "default": "excludes",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "a",
          "b"
        ],
        "title": "Excludes",
        "type": "object"
      },
      "FailurePenalty": {
        "additionalProperties": false,
        "description": "``points`` are subtracted when ``mission`` is attempted and ends failed.",
        "properties": {
          "kind": {
            "const": "failure_penalty",
            "default": "failure_penalty",
            "title": "Kind",
            "type": "string"
          },
          "mission": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Mission",
            "type": "string"
          },
          "points": {
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Points",
            "type": "number"
          }
        },
        "required": [
          "kind",
          "mission",
          "points"
        ],
        "title": "FailurePenalty",
        "type": "object"
      },
      "Fixed": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "fixed",
            "default": "fixed",
            "title": "Kind",
            "type": "string"
          },
          "value": {
            "maximum": 600.0,
            "minimum": 0.0,
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "kind",
          "value"
        ],
        "title": "Fixed",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "Issue": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "path": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Path",
            "type": "array"
          },
          "severity": {
            "default": "error",
            "enum": [
              "error",
              "warning"
            ],
            "title": "Severity",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "path",
          "severity"
        ],
        "title": "Issue",
        "type": "object"
      },
      "LogNormal": {
        "additionalProperties": false,
        "description": "Right-skewed, strictly positive. Parameterised by median and geometric std. deviation.\n\nIf ``X = median \u00b7 exp(\u03c3 Z)`` with ``Z ~ N(0, 1)`` and ``\u03c3 = ln(gsd)``, then\n``E[X] = median \u00b7 exp(\u03c3\u00b2 / 2)``.",
        "properties": {
          "gsd": {
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Gsd",
            "type": "number"
          },
          "kind": {
            "const": "lognormal",
            "default": "lognormal",
            "title": "Kind",
            "type": "string"
          },
          "median": {
            "exclusiveMinimum": 0.0,
            "maximum": 600.0,
            "title": "Median",
            "type": "number"
          }
        },
        "required": [
          "kind",
          "median",
          "gsd"
        ],
        "title": "LogNormal",
        "type": "object"
      },
      "Mission": {
        "additionalProperties": false,
        "description": "A task on the field.\n\n``approach_pose`` is where the robot must be (and which way it must face) to start the\nmission. It must be collision-free; the contact manoeuvre itself is part of\n``execution_time``. If ``max_attempts > 1`` and ``retry_time`` is omitted, each retry is\nassumed to take as long as the first attempt.",
        "properties": {
          "approach_pose": {
            "$ref": "#/components/schemas/Pose"
          },
          "attachment": {
            "anyOf": [
              {
                "maxLength": 120,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attachment"
          },
          "description": {
            "default": "",
            "maxLength": 2000,
            "title": "Description",
            "type": "string"
          },
          "execution_time": {
            "discriminator": {
              "mapping": {
                "empirical": "#/components/schemas/Empirical",
                "fixed": "#/components/schemas/Fixed",
                "lognormal": "#/components/schemas/LogNormal",
                "triangular": "#/components/schemas/Triangular"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/Fixed"
              },
              {
                "$ref": "#/components/schemas/Triangular"
              },
              {
                "$ref": "#/components/schemas/LogNormal"
              },
              {
                "$ref": "#/components/schemas/Empirical"
              }
            ],
            "title": "Execution Time"
          },
          "id": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Id",
            "type": "string"
          },
          "max_attempts": {
            "default": 1,
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Max Attempts",
            "type": "integer"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "retry_time": {
            "anyOf": [
              {
                "discriminator": {
                  "mapping": {
                    "empirical": "#/components/schemas/Empirical",
                    "fixed": "#/components/schemas/Fixed",
                    "lognormal": "#/components/schemas/LogNormal",
                    "triangular": "#/components/schemas/Triangular"
                  },
                  "propertyName": "kind"
                },
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Fixed"
                  },
                  {
                    "$ref": "#/components/schemas/Triangular"
                  },
                  {
                    "$ref": "#/components/schemas/LogNormal"
                  },
                  {
                    "$ref": "#/components/schemas/Empirical"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry Time"
          },
          "success": {
            "discriminator": {
              "mapping": {
                "counts": "#/components/schemas/CountsSuccess",
                "probability": "#/components/schemas/ProbabilitySuccess"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/ProbabilitySuccess"
              },
              {
                "$ref": "#/components/schemas/CountsSuccess"
              }
            ],
            "title": "Success"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "approach_pose",
          "execution_time",
          "success",
          "max_attempts",
          "retry_time",
          "attachment"
        ],
        "title": "Mission",
        "type": "object"
      },
      "MissionPoints": {
        "additionalProperties": false,
        "description": "``points`` are awarded when ``mission`` succeeds.",
        "properties": {
          "kind": {
            "const": "mission_points",
            "default": "mission_points",
            "title": "Kind",
            "type": "string"
          },
          "mission": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Mission",
            "type": "string"
          },
          "points": {
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Points",
            "type": "number"
          }
        },
        "required": [
          "kind",
          "mission",
          "points"
        ],
        "title": "MissionPoints",
        "type": "object"
      },
      "MotionProfile": {
        "additionalProperties": false,
        "description": "Speed limits for one degree of freedom.\n\nFor translation: ``max_speed`` in m/s and ``acceleration`` in m/s\u00b2.\nFor rotation: ``max_speed`` in rad/s and ``acceleration`` in rad/s\u00b2.\n``acceleration = None`` means a constant-speed model (instant start and stop).\n\n``provenance`` records where the numbers came from: ``calibrated`` (fitted from the user's\nmeasurements), ``entered`` (typed by the user) or ``reference`` (manufacturer ceiling).",
        "properties": {
          "acceleration": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 500.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Acceleration"
          },
          "max_speed": {
            "exclusiveMinimum": 0.0,
            "maximum": 50.0,
            "title": "Max Speed",
            "type": "number"
          },
          "provenance": {
            "default": "entered",
            "enum": [
              "calibrated",
              "entered",
              "reference"
            ],
            "title": "Provenance",
            "type": "string"
          }
        },
        "required": [
          "max_speed",
          "acceleration",
          "provenance"
        ],
        "title": "MotionProfile",
        "type": "object"
      },
      "Obstacle": {
        "additionalProperties": false,
        "description": "Something the robot's footprint must not overlap.\n\n``solid`` is a physical object (mission model, wall); ``no_go`` is an area the team chooses or\nis required to avoid. Both are treated identically by the planner; the kind only affects how\nthe UI draws them.",
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "default": "solid",
            "enum": [
              "solid",
              "no_go"
            ],
            "title": "Kind",
            "type": "string"
          },
          "label": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Label",
            "type": "string"
          },
          "shape": {
            "discriminator": {
              "mapping": {
                "circle": "#/components/schemas/CircleShape",
                "rect": "#/components/schemas/RectShape"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/RectShape"
              },
              {
                "$ref": "#/components/schemas/CircleShape"
              }
            ],
            "title": "Shape"
          }
        },
        "required": [
          "id",
          "label",
          "kind",
          "shape"
        ],
        "title": "Obstacle",
        "type": "object"
      },
      "Pose": {
        "additionalProperties": false,
        "description": "A position plus a heading (counter-clockwise from +x, normalised to (-\u03c0, \u03c0]).",
        "properties": {
          "theta": {
            "default": 0.0,
            "maximum": 10000.0,
            "minimum": -10000.0,
            "title": "Theta",
            "type": "number"
          },
          "x": {
            "maximum": 40.0,
            "minimum": -20.0,
            "title": "X",
            "type": "number"
          },
          "y": {
            "maximum": 40.0,
            "minimum": -20.0,
            "title": "Y",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "theta"
        ],
        "title": "Pose",
        "type": "object"
      },
      "Precedes": {
        "additionalProperties": false,
        "description": "If both missions are chosen, ``before`` must come first. Neither requires the other.",
        "properties": {
          "after": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "After",
            "type": "string"
          },
          "before": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Before",
            "type": "string"
          },
          "kind": {
            "const": "precedes",
            "default": "precedes",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "before",
          "after"
        ],
        "title": "Precedes",
        "type": "object"
      },
      "ProbabilitySuccess": {
        "additionalProperties": false,
        "description": "A per-attempt success probability entered directly.",
        "properties": {
          "kind": {
            "const": "probability",
            "default": "probability",
            "title": "Kind",
            "type": "string"
          },
          "p": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "P",
            "type": "number"
          }
        },
        "required": [
          "kind",
          "p"
        ],
        "title": "ProbabilitySuccess",
        "type": "object"
      },
      "RectShape": {
        "additionalProperties": false,
        "description": "Rectangle given by its centre, size and rotation about the centre.",
        "properties": {
          "cx": {
            "maximum": 40.0,
            "minimum": -20.0,
            "title": "Cx",
            "type": "number"
          },
          "cy": {
            "maximum": 40.0,
            "minimum": -20.0,
            "title": "Cy",
            "type": "number"
          },
          "height": {
            "exclusiveMinimum": 0.0,
            "maximum": 20.0,
            "title": "Height",
            "type": "number"
          },
          "kind": {
            "const": "rect",
            "default": "rect",
            "title": "Kind",
            "type": "string"
          },
          "rotation": {
            "default": 0.0,
            "maximum": 10000.0,
            "minimum": -10000.0,
            "title": "Rotation",
            "type": "number"
          },
          "width": {
            "exclusiveMinimum": 0.0,
            "maximum": 20.0,
            "title": "Width",
            "type": "number"
          }
        },
        "required": [
          "kind",
          "cx",
          "cy",
          "width",
          "height",
          "rotation"
        ],
        "title": "RectShape",
        "type": "object"
      },
      "Requires": {
        "additionalProperties": false,
        "description": "``after`` may only be done if ``before`` was done earlier.\n\n``semantics = \"succeeded\"``: ``after`` only scores if ``before`` succeeded (the robot skips\n``after`` when ``before`` failed). ``\"attempted\"``: ``before`` only has to be attempted.",
        "properties": {
          "after": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "After",
            "type": "string"
          },
          "before": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Before",
            "type": "string"
          },
          "kind": {
            "const": "requires",
            "default": "requires",
            "title": "Kind",
            "type": "string"
          },
          "semantics": {
            "default": "succeeded",
            "enum": [
              "attempted",
              "succeeded"
            ],
            "title": "Semantics",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "before",
          "after",
          "semantics"
        ],
        "title": "Requires",
        "type": "object"
      },
      "Robot": {
        "additionalProperties": false,
        "properties": {
          "angular": {
            "$ref": "#/components/schemas/MotionProfile"
          },
          "can_reverse": {
            "default": true,
            "description": "Whether the robot may drive backwards instead of turning around",
            "title": "Can Reverse",
            "type": "boolean"
          },
          "drive": {
            "const": "differential",
            "default": "differential",
            "title": "Drive",
            "type": "string"
          },
          "length": {
            "exclusiveMinimum": 0.0,
            "maximum": 20.0,
            "title": "Length",
            "type": "number"
          },
          "linear": {
            "$ref": "#/components/schemas/MotionProfile"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "safety_margin": {
            "default": 0.0,
            "maximum": 20.0,
            "minimum": 0.0,
            "title": "Safety Margin",
            "type": "number"
          },
          "width": {
            "exclusiveMinimum": 0.0,
            "maximum": 20.0,
            "title": "Width",
            "type": "number"
          }
        },
        "required": [
          "name",
          "drive",
          "length",
          "width",
          "safety_margin",
          "linear",
          "angular",
          "can_reverse"
        ],
        "title": "Robot",
        "type": "object"
      },
      "Scenario": {
        "additionalProperties": false,
        "properties": {
          "arena": {
            "$ref": "#/components/schemas/Arena"
          },
          "constraints": {
            "items": {
              "discriminator": {
                "mapping": {
                  "excludes": "#/components/schemas/Excludes",
